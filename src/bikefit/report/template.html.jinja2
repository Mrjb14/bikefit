<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BikeFit — Rapport {{ date }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #0f1117; color: #e2e8f0; line-height: 1.6; }
    .container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
    h1 { font-size: 1.8rem; font-weight: 700; color: #f7fafc; margin-bottom: 0.25rem; }
    h2 { font-size: 1.1rem; font-weight: 600; color: #a0aec0; margin: 2rem 0 1rem; text-transform: uppercase; letter-spacing: .08em; }
    .subtitle { color: #718096; font-size: 0.9rem; margin-bottom: 2rem; }
    /* résumé */
    .resume-box { background: #1a202c; border-left: 4px solid #4299e1; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 2rem; font-size: 0.95rem; }
    /* grille métriques */
    .metrics-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .metric-card { background: #1a202c; border-radius: 8px; padding: 1rem; border: 1px solid #2d3748; }
    .metric-card.ok   { border-color: #38a169; }
    .metric-card.warn { border-color: #e53e3e; }
    .metric-name  { font-size: 0.78rem; color: #718096; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .4rem; }
    .metric-value { font-size: 1.5rem; font-weight: 700; }
    .metric-card.ok   .metric-value { color: #68d391; }
    .metric-card.warn .metric-value { color: #fc8181; }
    .metric-std   { font-size: 0.75rem; color: #718096; }
    .metric-range { font-size: 0.72rem; color: #4a5568; margin-top: .25rem; }
    /* recommandations */
    .rec-list { display: flex; flex-direction: column; gap: .75rem; margin-bottom: 2rem; }
    .rec-card { background: #1a202c; border-radius: 8px; padding: 1rem 1.25rem; display: flex; align-items: flex-start; gap: 1rem; border: 1px solid #2d3748; }
    .rec-card.haute   { border-left: 4px solid #e53e3e; }
    .rec-card.moyenne { border-left: 4px solid #ed8936; }
    .rec-card.faible  { border-left: 4px solid #4299e1; }
    .rec-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: .2rem .5rem; border-radius: 4px; white-space: nowrap; }
    .rec-card.haute   .rec-badge { background: #e53e3e22; color: #fc8181; }
    .rec-card.moyenne .rec-badge { background: #ed893622; color: #fbd38d; }
    .rec-card.rec-card.faible  .rec-badge { background: #4299e122; color: #90cdf4; }
    .rec-body { flex: 1; }
    .rec-reglage { font-weight: 600; font-size: 0.95rem; }
    .rec-delta { display: inline-block; margin-left: .5rem; font-size: 0.85rem; color: #f6e05e; font-weight: 600; }
    .rec-motif { font-size: 0.85rem; color: #a0aec0; margin-top: .2rem; }
    .rec-butee { font-size: 0.75rem; color: #fc8181; margin-top: .2rem; }
    /* grille de graphes */
    .charts-grid { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
    .chart-card { background: #1a202c; border-radius: 8px; padding: .75rem 1rem; }
    .chart-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .25rem; }
    .chart-box { height: 200px; }
    /* rider bar */
    .rider-bar { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: 0.82rem; color: #a0aec0; margin-bottom: 1.25rem; padding: .5rem .75rem; background: #1a202c; border-radius: 6px; border: 1px solid #2d3748; }
    .rider-bar span { white-space: nowrap; }
    .geo-ref { color: #f6e05e; cursor: help; border-bottom: 1px dashed #f6e05e88; }
    /* footer */
    footer { font-size: 0.75rem; color: #4a5568; margin-top: 3rem; border-top: 1px solid #2d3748; padding-top: 1rem; }
  </style>
</head>
<body>
<div class="container">
  <h1>BikeFit — Analyse CLM</h1>
  <p class="subtitle">{{ video_name }} &nbsp;·&nbsp; {{ date }} &nbsp;·&nbsp; Profil : <strong>{{ report.profil_utilise }}</strong> &nbsp;·&nbsp; {{ metrics.n_cycles_used }} cycles &nbsp;·&nbsp; Détection {{ "%.0f"|format(metrics.detection_rate * 100) }}%</p>

  {% if rider %}
  <div class="rider-bar">
    {% if rider.taille %}<span>↕ {{ rider.taille }} mm</span>{% endif %}
    {% if rider.poids_kg %}<span>⚖ {{ rider.poids_kg }} kg</span>{% endif %}
    {% if rider.age %}<span>{{ rider.age }} ans</span>{% endif %}
    {% if rider.flexibilite %}<span>Flexibilité : {{ rider.flexibilite }}</span>{% endif %}
    {% if rider.type_epreuve %}<span>🎯 {{ rider.type_epreuve }}</span>{% endif %}
    {% if rider.echeance %}<span>📅 {{ rider.echeance }}</span>{% endif %}
    {% if rider.selle_geo_mm %}<span class="geo-ref" title="Formule LeMond — à valider au ruban">Selle géo. ~{{ rider.selle_geo_mm }} mm</span>{% endif %}
  </div>
  {% endif %}

  <div class="resume-box">{{ report.resume }}</div>

  <h2>Métriques angulaires</h2>
  <div class="metrics-grid">
    {% set cards = [
      ("Genou ext. PMB", metrics.genou_extension_pmb, "genou_extension_pmb"),
      ("Genou flex. PMH", metrics.genou_flexion_pmh,  "genou_flexion_pmh"),
      ("Hanche PMH",      metrics.hanche_fermee_pmh,  "hanche_fermee_pmh"),
      ("Tronc",           metrics.tronc,              "tronc"),
      ("Coude",           metrics.coude,              "coude"),
      ("Cheville PMB",    metrics.cheville_pmb,       "cheville_pmb"),
    ] %}
    {% for label, stat, key in cards %}
    {% set cls = "warn" if key in report.angles_hors_cible else "ok" %}
    <div class="metric-card {{ cls }}">
      <div class="metric-name">{{ label }}</div>
      <div class="metric-value">{{ "%.1f"|format(stat.mean) }}°</div>
      <div class="metric-std">± {{ "%.1f"|format(stat.std) }}° &nbsp; [{{ "%.1f"|format(stat.min) }} – {{ "%.1f"|format(stat.max) }}]</div>
    </div>
    {% endfor %}
  </div>

  <h2>Recommandations</h2>
  {% if report.recommandations %}
  <div class="rec-list">
    {% for rec in report.recommandations %}
    <div class="rec-card {{ rec.priorite }}">
      <span class="rec-badge">{{ rec.priorite }}</span>
      <div class="rec-body">
        <span class="rec-reglage">{{ rec.reglage.replace("_", " ").title() }}</span>
        <span>→ {{ rec.direction }}</span>
        {% if rec.delta_mm is not none %}<span class="rec-delta">~{{ rec.delta_mm|int }} mm</span>{% endif %}
        {% if rec.butee_atteinte %}<div class="rec-butee">⚠ Butée de réglage atteinte</div>{% endif %}
        <div class="rec-motif">{{ rec.motif }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:#68d391">Aucun réglage suggéré — position dans les plages cibles.</p>
  {% endif %}

  <h2>Schéma des réglages</h2>
  <div style="background:#1a202c;border-radius:8px;padding:1.5rem 1rem;margin-bottom:2rem;overflow:hidden">
    <svg viewBox="0 0 760 430" style="width:100%;display:block" font-family="system-ui,-apple-system,sans-serif">
      <!--
        Silhouette CLM style Cervelo/Trinity :
        - Triangle ARRIÈRE compact (roue arrière proche du BB)
        - Tube de selle ~78° (quasi vertical)
        - Tube de direction court (~35px)
        - Fourche longue vers l'avant
        - Selle HAUTE, bars/prolongateurs BAS (drop important)
        - Section principale du cadre avec forme plus remplie (stroke épais)
      -->

      <!-- ══ ROUES (r=70) ══ -->
      <!-- Roue arrière -->
      <circle cx="180" cy="298" r="70" fill="none" stroke="#3d4a5c" stroke-width="11"/>
      <circle cx="180" cy="298" r="59" fill="none" stroke="#2d3748" stroke-width="1.5" stroke-dasharray="8,6"/>
      <circle cx="180" cy="298" r="8"  fill="#4a5568"/>
      <!-- Roue avant -->
      <circle cx="598" cy="298" r="70" fill="none" stroke="#3d4a5c" stroke-width="11"/>
      <circle cx="598" cy="298" r="59" fill="none" stroke="#2d3748" stroke-width="1.5" stroke-dasharray="8,6"/>
      <circle cx="598" cy="298" r="8"  fill="#4a5568"/>

      <!-- ══ TRIANGLE ARRIÈRE ══
           Chainstays très courts (roue arr. proche du BB) = look TT -->
      <!-- Bases de chaîne -->
      <line x1="330" y1="302" x2="180" y2="298" stroke="#8090a8" stroke-width="8"  stroke-linecap="round"/>
      <!-- Haubans (seatstays) - fins -->
      <line x1="180" y1="298" x2="302" y2="158" stroke="#6a7d96" stroke-width="6"  stroke-linecap="round"/>

      <!-- ══ CADRE PRINCIPAL ══ -->
      <!-- Tube de selle (78° = quasi vertical, remonte 140px, recul 29px) -->
      <line x1="330" y1="302" x2="302" y2="158" stroke="#b0bdd0" stroke-width="13" stroke-linecap="round"/>

      <!-- Tube supérieur (presque plat, stack faible = caractéristique TT) -->
      <line x1="302" y1="158" x2="490" y2="165" stroke="#b0bdd0" stroke-width="10" stroke-linecap="round"/>

      <!-- Tube diagonal (de BB vers bas du tube de direction) -->
      <line x1="330" y1="302" x2="502" y2="197" stroke="#b0bdd0" stroke-width="13" stroke-linecap="round"/>

      <!-- Tube de direction (très court = ~35px, distinctif CLM) -->
      <line x1="490" y1="165" x2="502" y2="197" stroke="#c0cce0" stroke-width="15" stroke-linecap="round"/>

      <!-- Fourche (longue, inclinée vers l'avant — reach important TT) -->
      <line x1="502" y1="197" x2="598" y2="298" stroke="#8090a8" stroke-width="9"  stroke-linecap="round"/>

      <!-- ══ PÉDALIER ══ -->
      <circle cx="330" cy="302" r="32" fill="none" stroke="#3d4a5c" stroke-width="3"/>
      <circle cx="330" cy="302" r="13" fill="#2d3748" stroke="#8090a8" stroke-width="3"/>
      <!-- Manivelle à 3h -->
      <line x1="330" y1="302" x2="373" y2="304" stroke="#8090a8" stroke-width="7" stroke-linecap="round"/>
      <!-- Pédale -->
      <rect x="370" y="298" width="17" height="8" rx="2" fill="#4a5568"/>

      <!-- ══ TIGE DE SELLE + SELLE ══ -->
      <!-- Tige de selle (même angle 78°, +38px au-dessus du tube) -->
      <line x1="304" y1="160" x2="293" y2="121" stroke="#8090a8" stroke-width="6" stroke-linecap="round"/>
      <!-- Selle CLM : plate, nez légèrement descendant vers l'avant, nez ~au-dessus du BB -->
      <path d="M264,124 Q296,116 338,122" fill="none" stroke="#e8edf5" stroke-width="8" stroke-linecap="round"/>

      <!-- ══ COCKPIT CLM / AEROBARS ══ -->
      <!-- Potence courte (stem) -->
      <line x1="490" y1="165" x2="508" y2="150" stroke="#8090a8" stroke-width="7" stroke-linecap="round"/>
      <!-- Cintre de base court -->
      <line x1="508" y1="150" x2="538" y2="148" stroke="#8090a8" stroke-width="6" stroke-linecap="round"/>
      <!-- Pads repose-avant-bras (deux blocs) -->
      <rect x="512" y="138" width="23" height="10" rx="3" fill="#718096"/>
      <rect x="539" y="136" width="23" height="10" rx="3" fill="#718096"/>
      <!-- Prolongateurs (extensions) horizontaux, légèrement inclinés vers le bas -->
      <line x1="523" y1="143" x2="648" y2="132" stroke="#b0bdd0" stroke-width="6" stroke-linecap="round"/>
      <line x1="551" y1="141" x2="652" y2="130" stroke="#b0bdd0" stroke-width="6" stroke-linecap="round"/>
      <!-- Embouts / coudes prolongateurs -->
      <circle cx="648" cy="132" r="6" fill="#3d4a5c"/>
      <circle cx="652" cy="130" r="6" fill="#3d4a5c"/>

      <!-- ══ ANNOTATIONS ══ -->

      <!-- 1. HAUTEUR SELLE — dot au-dessus de la tige (selle) -->
      {% set a = ann["hauteur_selle"] %}
      <line x1="292" y1="120" x2="120" y2="109" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="292" cy="120" r="7" fill="{{ a.color }}"/>
      <rect x="10" y="90" width="110" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="65" y="105" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">HAUTEUR SELLE</text>
      {% if a.delta is not none %}
      <text x="65" y="120" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="65" y="120" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 2. RECUL SELLE — dot sur collier / haut tube de selle -->
      {% set a = ann["recul_selle"] %}
      <line x1="304" y1="160" x2="215" y2="68" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="304" cy="160" r="7" fill="{{ a.color }}"/>
      <rect x="155" y="30" width="120" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="215" y="45" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">RECUL SELLE</text>
      {% if a.delta is not none %}
      <text x="215" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="215" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 3. HAUTEUR PADS — dot sur le pad gauche -->
      {% set a = ann["hauteur_prolongateurs"] %}
      <line x1="525" y1="143" x2="490" y2="68" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="525" cy="143" r="7" fill="{{ a.color }}"/>
      <rect x="430" y="30" width="120" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="490" y="45" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">HAUTEUR PADS</text>
      {% if a.delta is not none %}
      <text x="490" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="490" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 4. LONGUEUR PROLONGATEURS — dot à l'embout -->
      {% set a = ann["longueur_prolongateurs"] %}
      <line x1="648" y1="132" x2="683" y2="68" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="648" cy="132" r="7" fill="{{ a.color }}"/>
      <rect x="613" y="30" width="138" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="682" y="45" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">LONGUEUR PROLONG.</text>
      {% if a.delta is not none %}
      <text x="682" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="682" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 5. CALE / TECHNIQUE PÉDALAGE — dot sur la pédale -->
      {% set a = ann["cale_chaussure"] %}
      <line x1="372" y1="303" x2="425" y2="362" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="372" cy="303" r="7" fill="{{ a.color }}"/>
      <rect x="362" y="362" width="126" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="425" y="377" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">CALE / TECHNIQUE</text>
      {% if a.delta is not none %}
      <text x="425" y="392" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="425" y="392" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

    </svg>
    <!-- légende -->
    <div style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:.75rem;font-size:.78rem;color:#718096">
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#fc8181;margin-right:.4rem;vertical-align:middle"></span>Priorité haute</span>
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#fbd38d;margin-right:.4rem;vertical-align:middle"></span>Priorité moyenne</span>
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#90cdf4;margin-right:.4rem;vertical-align:middle"></span>Priorité faible</span>
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#4a5568;margin-right:.4rem;vertical-align:middle"></span>Aucun réglage</span>
    </div>
  </div>

  <h2>Angles par frame</h2>
  <div class="charts-grid">
    <div class="chart-card">
      <div class="chart-label" style="color:#68d391">Genou</div>
      <div id="chart-genou" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#f6ad55">Hanche</div>
      <div id="chart-hanche" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#90cdf4">Tronc</div>
      <div id="chart-tronc" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#fc8181">Coude</div>
      <div id="chart-coude" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#b794f4">Cheville</div>
      <div id="chart-cheville" class="chart-box"></div>
    </div>
  </div>

  <footer>Généré par BikeFit CLM &nbsp;·&nbsp; {{ date }}</footer>
</div>

<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<script>
const chartsData = {{ charts_json }};
const baseLayout = {
  paper_bgcolor: "rgba(0,0,0,0)",
  plot_bgcolor:  "#1a202c",
  font: { color: "#a0aec0", size: 11 },
  margin: { t: 8, r: 12, b: 36, l: 44 },
  xaxis: { title: { text: "Frame", font: { size: 10 } }, gridcolor: "#2d3748", zeroline: false, tickfont: { size: 10 } },
  yaxis: { title: { text: "°", font: { size: 10 } }, gridcolor: "#2d3748", zeroline: false, tickfont: { size: 10 } },
  hovermode: "x",
};
const cfg = { responsive: true, displayModeBar: false };
for (const [col, data] of Object.entries(chartsData)) {
  Plotly.newPlot(`chart-${col}`, data.traces, { ...baseLayout }, cfg);
}
</script>
</body>
</html>
