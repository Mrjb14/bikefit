{% macro unreliable_note(stat) -%}
<div class="metric-unreliable" title="Calculée sur des points inférés par le modèle, pas réellement observés">
  ⚠ peu fiable{% if stat.visibility is not none %} — visibilité {{ "%.2f"|format(stat.visibility) }}{% endif %}{% if stat.frames_kept is not none %}, {{ "%.0f"|format(stat.frames_kept * 100) }}% des frames{% endif %}
</div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BikeFit — Rapport {{ date }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #0f1117; color: #e2e8f0; line-height: 1.6; }
    .container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
    h1 { font-size: 1.8rem; font-weight: 700; color: #f7fafc; margin-bottom: 0.25rem; }
    h2 { font-size: 1.1rem; font-weight: 600; color: #a0aec0; margin: 2rem 0 1rem; text-transform: uppercase; letter-spacing: .08em; }
    .subtitle { color: #718096; font-size: 0.9rem; margin-bottom: 2rem; }
    /* résumé */
    .resume-box { background: #1a202c; border-left: 4px solid #4299e1; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 2rem; font-size: 0.95rem; }
    /* grille métriques */
    .metrics-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .metric-card { background: #1a202c; border-radius: 8px; padding: 1rem; border: 1px solid #2d3748; }
    .metric-card.ok   { border-color: #38a169; }
    .metric-card.warn { border-color: #e53e3e; }
    .metric-name  { font-size: 0.78rem; color: #718096; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .4rem; }
    .metric-value { font-size: 1.5rem; font-weight: 700; }
    .metric-card.ok   .metric-value { color: #68d391; }
    .metric-card.warn .metric-value { color: #fc8181; }
    .metric-std   { font-size: 0.75rem; color: #718096; }
    .metric-range { font-size: 0.72rem; color: #4a5568; margin-top: .25rem; }
    .metric-unreliable { font-size: 0.72rem; color: #fbd38d; margin-top: .35rem; background: #ed893622; border-radius: 4px; padding: .15rem .4rem; cursor: help; }
    /* recommandations */
    .rec-list { display: flex; flex-direction: column; gap: .75rem; margin-bottom: 2rem; }
    .rec-card { background: #1a202c; border-radius: 8px; padding: 1rem 1.25rem; display: flex; align-items: flex-start; gap: 1rem; border: 1px solid #2d3748; }
    .rec-card.haute   { border-left: 4px solid #e53e3e; }
    .rec-card.moyenne { border-left: 4px solid #ed8936; }
    .rec-card.faible  { border-left: 4px solid #4299e1; }
    .rec-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: .2rem .5rem; border-radius: 4px; white-space: nowrap; }
    .rec-card.haute   .rec-badge { background: #e53e3e22; color: #fc8181; }
    .rec-card.moyenne .rec-badge { background: #ed893622; color: #fbd38d; }
    .rec-card.rec-card.faible  .rec-badge { background: #4299e122; color: #90cdf4; }
    .rec-body { flex: 1; }
    .rec-reglage { font-weight: 600; font-size: 0.95rem; }
    .rec-delta { display: inline-block; margin-left: .5rem; font-size: 0.85rem; color: #f6e05e; font-weight: 600; }
    .rec-motif { font-size: 0.85rem; color: #a0aec0; margin-top: .2rem; }
    .rec-butee { font-size: 0.75rem; color: #fc8181; margin-top: .2rem; }
    /* grille de graphes */
    .charts-grid { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
    .chart-card { background: #1a202c; border-radius: 8px; padding: .75rem 1rem; }
    .chart-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .25rem; }
    .chart-box { height: 200px; }
    /* rider bar */
    .rider-bar { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: 0.82rem; color: #a0aec0; margin-bottom: 1.25rem; padding: .5rem .75rem; background: #1a202c; border-radius: 6px; border: 1px solid #2d3748; }
    .rider-bar span { white-space: nowrap; }
    .geo-ref { color: #f6e05e; cursor: help; border-bottom: 1px dashed #f6e05e88; }
    /* footer */
    footer { font-size: 0.75rem; color: #4a5568; margin-top: 3rem; border-top: 1px solid #2d3748; padding-top: 1rem; }
  </style>
</head>
<body>
<div class="container">
  <h1>BikeFit — Analyse CLM</h1>
  <p class="subtitle">{{ video_name }} &nbsp;·&nbsp; {{ date }} &nbsp;·&nbsp; Profil : <strong>{{ report.profil_utilise }}</strong> &nbsp;·&nbsp; {{ metrics.n_cycles_used }} cycles &nbsp;·&nbsp; Détection {{ "%.0f"|format(metrics.detection_rate * 100) }}%</p>

  {% if rider %}
  <div class="rider-bar">
    {% if rider.taille %}<span>↕ {{ rider.taille }} mm</span>{% endif %}
    {% if rider.poids_kg %}<span>⚖ {{ rider.poids_kg }} kg</span>{% endif %}
    {% if rider.age %}<span>{{ rider.age }} ans</span>{% endif %}
    {% if rider.flexibilite %}<span>Flexibilité : {{ rider.flexibilite }}</span>{% endif %}
    {% if rider.type_epreuve %}<span>🎯 {{ rider.type_epreuve }}</span>{% endif %}
    {% if rider.echeance %}<span>📅 {{ rider.echeance }}</span>{% endif %}
    {% if rider.selle_geo_mm %}<span class="geo-ref" title="Formule LeMond — à valider au ruban">Selle géo. ~{{ rider.selle_geo_mm }} mm</span>{% endif %}
  </div>
  {% endif %}

  <div class="resume-box">{{ report.resume }}</div>

  <h2>Métriques angulaires</h2>
  <div class="metrics-grid">
    {% set cards = [
      ("Genou ext. PMB", metrics.genou_extension_pmb, "genou_extension_pmb"),
      ("Genou flex. PMH", metrics.genou_flexion_pmh,  "genou_flexion_pmh"),
      ("Hanche PMH",      metrics.hanche_fermee_pmh,  "hanche_fermee_pmh"),
      ("Tronc",           metrics.tronc,              "tronc"),
      ("Coude",           metrics.coude,              "coude"),
      ("Cheville PMB",    metrics.cheville_pmb,       "cheville_pmb"),
    ] %}
    {% for label, stat, key in cards %}
    {% set cls = "warn" if (key in report.angles_hors_cible or not stat.is_measured) else "ok" %}
    <div class="metric-card {{ cls }}">
      <div class="metric-name">{{ label }}</div>
      {% if stat.is_measured %}
      <div class="metric-value">{{ "%.1f"|format(stat.mean) }}°</div>
      <div class="metric-std">± {{ "%.1f"|format(stat.std) }}° &nbsp; [{{ "%.1f"|format(stat.min) }} – {{ "%.1f"|format(stat.max) }}]</div>
      {% if not stat.is_reliable %}{{ unreliable_note(stat) }}{% endif %}
      {% else %}
      <div class="metric-value">—</div>
      <div class="metric-unreliable" title="Aucun cycle exploitable : point masqué ou inféré sur toute la vidéo">
        ⚠ non mesuré — aucun cycle exploitable
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {% if metrics.genou_deviation_gauche or metrics.genou_deviation_droit or metrics.largeur_coudes %}
  <h2>Plan frontal (vue de face)</h2>
  <div class="metrics-grid">
    {% set frontal_cards = [
      ("Déviation genou G", metrics.genou_deviation_gauche, "°"),
      ("Déviation genou D", metrics.genou_deviation_droit, "°"),
      ("Largeur coudes",    metrics.largeur_coudes,         " mm"),
    ] %}
    {% for label, stat, unit in frontal_cards %}
    {% if stat %}
    <div class="metric-card {{ 'warn' if not stat.is_reliable else 'ok' }}">
      <div class="metric-name">{{ label }}</div>
      <div class="metric-value">{{ "%.1f"|format(stat.mean) }}{{ unit }}</div>
      <div class="metric-std">± {{ "%.1f"|format(stat.std) }}{{ unit }} &nbsp; {{ stat.n_cycles }} cycles</div>
      {% if not stat.is_reliable %}{{ unreliable_note(stat) }}{% endif %}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <h2>Recommandations</h2>
  {% if report.recommandations %}
  <div class="rec-list">
    {% for rec in report.recommandations %}
    <div class="rec-card {{ rec.priorite }}">
      <span class="rec-badge">{{ rec.priorite }}</span>
      <div class="rec-body">
        <span class="rec-reglage">{{ rec.reglage.replace("_", " ").title() }}</span>
        <span>→ {{ rec.direction }}</span>
        {% if rec.delta_mm is not none %}<span class="rec-delta">~{{ rec.delta_mm|int }} mm</span>{% endif %}
        {% if rec.butee_atteinte %}<div class="rec-butee">⚠ Butée de réglage atteinte</div>{% endif %}
        <div class="rec-motif">{{ rec.motif }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:#68d391">Aucun réglage suggéré — position dans les plages cibles.</p>
  {% endif %}

  <h2>Schéma des réglages</h2>
  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:2rem">
  <div style="flex:2 1 500px;background:#1a202c;border-radius:8px;padding:1.5rem 1rem;overflow:hidden">
    <div style="text-align:center;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#718096;margin-bottom:.75rem">Vue de côté</div>
    <svg viewBox="0 0 760 430" style="width:100%;display:block" font-family="system-ui,-apple-system,sans-serif">
      <!--
        Géométrie CLM / TT corrigée :
        r=85 (vs 70) · empattement 350px → ratio roue/empattement ≈ 2:1 (réaliste)
        Fourche 22° depuis la verticale · tube sup. quasi horizontal · roue arr. disque
      -->

      <!-- ══ ROUES r=85 ══ -->
      <!-- Roue arrière — disque (CLM) -->
      <circle cx="205" cy="298" r="85"  fill="none"   stroke="#3d4a5c" stroke-width="12"/>
      <circle cx="205" cy="298" r="72"  fill="#1a2333" stroke="#2d3748" stroke-width="1.5"/>
      <circle cx="205" cy="298" r="9"   fill="#4a5568"/>

      <!-- Roue avant — rayonnée -->
      <circle cx="555" cy="298" r="85"  fill="none"   stroke="#3d4a5c" stroke-width="12"/>
      <circle cx="555" cy="298" r="72"  fill="none"   stroke="#2d3748" stroke-width="1.5" stroke-dasharray="9,7"/>
      <circle cx="555" cy="298" r="9"   fill="#4a5568"/>

      <!-- ══ TRIANGLE ARRIÈRE ══ -->
      <!-- Bases de chaîne (quasi horizontales — compact TT) -->
      <line x1="325" y1="310" x2="205" y2="298" stroke="#8090a8" stroke-width="8"  stroke-linecap="round"/>
      <!-- Haubans -->
      <line x1="205" y1="298" x2="298" y2="180" stroke="#6a7d96" stroke-width="6"  stroke-linecap="round"/>

      <!-- ══ CADRE PRINCIPAL ══ -->
      <!-- Tube de selle (78° — quasi vertical) -->
      <line x1="325" y1="310" x2="298" y2="180" stroke="#b0bdd0" stroke-width="13" stroke-linecap="round"/>

      <!-- Tube supérieur (5px de dénivelé sur 214px — quasi horizontal) -->
      <line x1="298" y1="180" x2="512" y2="185" stroke="#b0bdd0" stroke-width="10" stroke-linecap="round"/>

      <!-- Tube diagonal -->
      <line x1="325" y1="310" x2="523" y2="218" stroke="#b0bdd0" stroke-width="13" stroke-linecap="round"/>

      <!-- Tube de direction court (72°) -->
      <line x1="512" y1="185" x2="523" y2="218" stroke="#c0cce0" stroke-width="15" stroke-linecap="round"/>

      <!-- Fourche raide (dx=32 dy=80 → 22° depuis la verticale) -->
      <line x1="523" y1="218" x2="555" y2="298" stroke="#8090a8" stroke-width="9"  stroke-linecap="round"/>

      <!-- ══ PÉDALIER ══ -->
      <circle cx="325" cy="310" r="30"  fill="none"   stroke="#3d4a5c" stroke-width="3"/>
      <circle cx="325" cy="310" r="12"  fill="#2d3748" stroke="#8090a8" stroke-width="3"/>
      <!-- Manivelle à 3h -->
      <line x1="325" y1="310" x2="370" y2="312" stroke="#8090a8" stroke-width="7"  stroke-linecap="round"/>
      <!-- Pédale -->
      <rect x="368" y="306" width="16"  height="8" rx="2" fill="#4a5568"/>

      <!-- ══ TIGE DE SELLE + SELLE ══ -->
      <!-- Tige (dans l'axe du tube de selle) -->
      <line x1="300" y1="182" x2="290" y2="141" stroke="#8090a8" stroke-width="6"  stroke-linecap="round"/>
      <!-- Selle CLM plate -->
      <path d="M263,145 Q291,136 328,142" fill="none" stroke="#e8edf5" stroke-width="8" stroke-linecap="round"/>

      <!-- ══ COCKPIT CLM (aerobars) ══ -->
      <!-- Tige courte quasi verticale -->
      <line x1="512" y1="185" x2="514" y2="165" stroke="#8090a8" stroke-width="7"  stroke-linecap="round"/>
      <!-- Base bar courte -->
      <line x1="498" y1="165" x2="530" y2="163" stroke="#8090a8" stroke-width="6"  stroke-linecap="round"/>
      <!-- Pads -->
      <rect x="497" y="152" width="24"  height="12" rx="3" fill="#718096"/>
      <rect x="524" y="150" width="24"  height="12" rx="3" fill="#718096"/>
      <!-- Prolongateurs quasi horizontaux -->
      <line x1="508" y1="164" x2="618" y2="154" stroke="#b0bdd0" stroke-width="6"  stroke-linecap="round"/>
      <line x1="535" y1="162" x2="621" y2="152" stroke="#b0bdd0" stroke-width="6"  stroke-linecap="round"/>
      <!-- Embouts -->
      <circle cx="618" cy="154" r="6"  fill="#3d4a5c"/>
      <circle cx="621" cy="152" r="6"  fill="#3d4a5c"/>

      <!-- ══ ANNOTATIONS ══ -->

      <!-- 1. HAUTEUR SELLE -->
      {% set a = ann["hauteur_selle"] %}
      <line x1="290" y1="140" x2="120" y2="109" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="290" cy="140" r="7" fill="{{ a.color }}"/>
      <rect x="10" y="90" width="110" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="65" y="105" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">HAUTEUR SELLE</text>
      {% if a.delta is not none %}
      <text x="65" y="120" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="65" y="120" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 2. RECUL SELLE -->
      {% set a = ann["recul_selle"] %}
      <line x1="300" y1="181" x2="215" y2="68" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="300" cy="181" r="7" fill="{{ a.color }}"/>
      <rect x="155" y="30" width="120" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="215" y="45" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">RECUL SELLE</text>
      {% if a.delta is not none %}
      <text x="215" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="215" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 3. HAUTEUR PADS -->
      {% set a = ann["hauteur_prolongateurs"] %}
      <line x1="510" y1="164" x2="490" y2="68" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="510" cy="164" r="7" fill="{{ a.color }}"/>
      <rect x="430" y="30" width="120" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="490" y="45" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">HAUTEUR PADS</text>
      {% if a.delta is not none %}
      <text x="490" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="490" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 4. LONGUEUR PROLONGATEURS -->
      {% set a = ann["longueur_prolongateurs"] %}
      <line x1="618" y1="154" x2="670" y2="68" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="618" cy="154" r="7" fill="{{ a.color }}"/>
      <rect x="600" y="30" width="148" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="674" y="45" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">LONGUEUR PROLONG.</text>
      {% if a.delta is not none %}
      <text x="674" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="674" y="60" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

      <!-- 5. CALE / TECHNIQUE PÉDALAGE -->
      {% set a = ann["cale_chaussure"] %}
      <line x1="370" y1="313" x2="380" y2="365" stroke="{{ a.color }}" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.85"/>
      <circle cx="370" cy="313" r="7" fill="{{ a.color }}"/>
      <rect x="317" y="365" width="126" height="38" rx="4" fill="#0f1117" stroke="{{ a.color }}" stroke-width="1.5"/>
      <text x="380" y="380" text-anchor="middle" fill="{{ a.color }}" font-size="9" font-weight="700" letter-spacing=".06em">CALE / TECHNIQUE</text>
      {% if a.delta is not none %}
      <text x="380" y="395" text-anchor="middle" fill="{{ a.color }}" font-size="11">{{ a.direction }} ~{{ a.delta|int }} mm</text>
      {% else %}
      <text x="380" y="395" text-anchor="middle" fill="{{ a.color }}" font-size="11">—</text>
      {% endif %}

    </svg>
    <!-- légende -->
    <div style="display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:.75rem;font-size:.78rem;color:#718096">
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#fc8181;margin-right:.4rem;vertical-align:middle"></span>Priorité haute</span>
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#fbd38d;margin-right:.4rem;vertical-align:middle"></span>Priorité moyenne</span>
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#90cdf4;margin-right:.4rem;vertical-align:middle"></span>Priorité faible</span>
      <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#4a5568;margin-right:.4rem;vertical-align:middle"></span>Aucun réglage</span>
    </div>
  </div>

  <div style="flex:1 1 220px;background:#1a202c;border-radius:8px;padding:1.5rem 1rem;overflow:hidden">
    <div style="text-align:center;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#718096;margin-bottom:.75rem">Vue de face</div>
    <svg viewBox="0 0 260 430" style="width:100%;display:block" font-family="system-ui,-apple-system,sans-serif">
      <!-- Vue de face stylisée : roue avant + potence/direction + cintre aero, vus dans l'axe -->

      <!-- ══ ROUE VUE PAR LA TRANCHE (pneu = capsule fine, pas un cercle) ══ -->
      <rect x="121" y="262" width="18" height="156" rx="9" fill="#2d3748" stroke="#3d4a5c" stroke-width="4"/>
      <circle cx="130" cy="340" r="5" fill="#4a5568"/>

      <!-- ══ FOURCHE / DIRECTION (steerer, jambes de fourche superposées de face) ══ -->
      <line x1="130" y1="262" x2="130" y2="175" stroke="#8090a8" stroke-width="9" stroke-linecap="round"/>
      <line x1="130" y1="175" x2="130" y2="145" stroke="#c0cce0" stroke-width="10" stroke-linecap="round"/>

      <!-- Amorces tube sup. / tube diagonal (cadre en grande partie masqué de face) -->
      <line x1="130" y1="175" x2="108" y2="200" stroke="#6a7d96" stroke-width="5" stroke-linecap="round"/>
      <line x1="130" y1="175" x2="152" y2="197" stroke="#b0bdd0" stroke-width="6" stroke-linecap="round"/>

      <!-- ══ POTENCE ══ -->
      <rect x="124" y="145" width="12" height="13" rx="2" fill="#718096"/>

      <!-- ══ CINTRE + COCOTTES ══ -->
      <line x1="90" y1="145" x2="170" y2="145" stroke="#b0bdd0" stroke-width="8" stroke-linecap="round"/>
      <rect x="84"  y="140" width="14" height="11" rx="3" fill="#718096"/>
      <rect x="162" y="140" width="14" height="11" rx="3" fill="#718096"/>

      <!-- ══ PADS AERO (symétriques) ══ -->
      <rect x="99"  y="120" width="24" height="13" rx="3" fill="#718096"/>
      <rect x="137" y="120" width="24" height="13" rx="3" fill="#718096"/>
      <!-- Extrémités des prolongateurs, pointant vers la caméra (vues en coupe) -->
      <circle cx="111" cy="112" r="5" fill="none" stroke="#b0bdd0" stroke-width="3"/>
      <circle cx="149" cy="112" r="5" fill="none" stroke="#b0bdd0" stroke-width="3"/>

      {% if metrics.largeur_coudes %}
      <!-- Largeur coudes mesurée (vue de face, Phase 3C) -->
      <line x1="99" y1="126" x2="161" y2="126" stroke="#f6e05e" stroke-width="1.5" stroke-dasharray="4,3" opacity="0.85"/>
      <text x="130" y="106" text-anchor="middle" fill="#f6e05e" font-size="10">↔ {{ metrics.largeur_coudes.mean|int }} mm</text>
      {% endif %}
    </svg>
    {% if metrics.genou_deviation_gauche and metrics.genou_deviation_droit %}
    <div style="text-align:center;font-size:.72rem;color:#a0aec0;margin-top:.5rem">
      Déviation genoux : G {{ "%.1f"|format(metrics.genou_deviation_gauche.mean) }}° · D {{ "%.1f"|format(metrics.genou_deviation_droit.mean) }}°
    </div>
    {% endif %}
  </div>
  </div>

  <h2>Angles par frame</h2>
  <div class="charts-grid">
    <div class="chart-card">
      <div class="chart-label" style="color:#68d391">Genou</div>
      <div id="chart-genou" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#f6ad55">Hanche</div>
      <div id="chart-hanche" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#90cdf4">Tronc</div>
      <div id="chart-tronc" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#fc8181">Coude</div>
      <div id="chart-coude" class="chart-box"></div>
    </div>
    <div class="chart-card">
      <div class="chart-label" style="color:#b794f4">Cheville</div>
      <div id="chart-cheville" class="chart-box"></div>
    </div>
  </div>

  <footer>Généré par BikeFit CLM &nbsp;·&nbsp; {{ date }}</footer>
</div>

<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<script>
const chartsData = {{ charts_json | safe }};
const baseLayout = {
  paper_bgcolor: "rgba(0,0,0,0)",
  plot_bgcolor:  "#1a202c",
  font: { color: "#a0aec0", size: 11 },
  margin: { t: 8, r: 12, b: 36, l: 44 },
  xaxis: { title: { text: "Frame", font: { size: 10 } }, gridcolor: "#2d3748", zeroline: false, tickfont: { size: 10 } },
  yaxis: { title: { text: "°", font: { size: 10 } }, gridcolor: "#2d3748", zeroline: false, tickfont: { size: 10 } },
  hovermode: "x",
};
const cfg = { responsive: true, displayModeBar: false };
for (const [col, data] of Object.entries(chartsData)) {
  Plotly.newPlot(`chart-${col}`, data.traces, { ...baseLayout }, cfg);
}
</script>
</body>
</html>
